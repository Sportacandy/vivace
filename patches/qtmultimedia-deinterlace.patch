index 0000000..c887181
--- /dev/null
+++ b/src/plugins/multimedia/ffmpeg/playbackengine/qffmpegdeinterlacer_p.h
@@ -0,0 +1,108 @@
+/*  Vivace — a fast, pure-Qt media player.
+    Copyright (C) 2026 Hironori Komaba
+    SPDX-License-Identifier: GPL-3.0-or-later
+*/
+
+#ifndef QFFMPEGDEINTERLACER_P_H
+#define QFFMPEGDEINTERLACER_P_H
+
+//
+//  W A R N I N G
+//  -------------
+//
+// This file is not part of the Qt API. It exists purely as an
+// implementation detail. This header file may change from version to
+// version without notice, or even be removed.
+//
+// We mean it.
+//
+
+// Vivace: optional software deinterlacing for the FFmpeg playback path.
+// Qt Multimedia's own decode pipeline has no filter-graph stage at all and
+// no interlace awareness whatsoever (StreamDecoder::receiveAVFrames() hands
+// avcodec_receive_frame()'s raw AVFrame straight to a Frame/QVideoFrame),
+// so this is implemented as a small FFmpeg avfilter graph (yadif or bwdif)
+// spliced into VideoRenderer::renderInternal(), the sole AVFrame -> QVideoFrame
+// conversion point. Gated by the VIVACE_DEINTERLACE_MODE environment
+// variable (0 = off, 1 = yadif, 2 = bwdif), read fresh by the renderer on
+// every frame and set by Vivace's own C++ (PlayerController) whenever the
+// user changes the Video > Deinterlace menu selection -- the same
+// env-var-relay pattern already used for VIVACE_SUBTITLE_BITMAP_SMOOTHING.
+//
+// SCOPE: single-rate only (one output frame per input frame -- yadif/bwdif
+// "mode=send_frame"), NOT the "double framerate"/bob variants. Those need
+// the ability to inject a second, synthesized frame with its own timestamp
+// per input frame, which Renderer's frame-queueing (a private, one-Frame-
+// per-renderInternal()-call contract) does not support without much deeper
+// surgery -- out of scope for this patch.
+
+#include <QtFFmpegMediaPluginImpl/private/qffmpegplaybackutils_p.h>
+#include <QtFFmpegMediaPluginImpl/private/qffmpegtime_p.h>
+#include <QtFFmpegMediaPluginImpl/private/qffmpeg_p.h>
+
+#include <QtCore/qqueue.h>
+
+#include <utility>
+
+extern "C" {
+#include <libavfilter/avfilter.h>
+}
+
+QT_BEGIN_NAMESPACE
+
+namespace QFFmpeg {
+
+class Deinterlacer
+{
+public:
+    enum Mode {
+        Yadif = 1,
+        Bwdif = 2,
+    };
+
+    explicit Deinterlacer(int mode) : m_mode(mode) { }
+    ~Deinterlacer();
+
+    Q_DISABLE_COPY_MOVE(Deinterlacer)
+
+    int mode() const { return m_mode; }
+
+    // Pushes a reference to `inputFrame` (NOT consumed -- the caller keeps
+    // ownership) into the filter graph, tagged with `startTime`/`duration`.
+    // yadif/bwdif have a fixed one-frame lookahead latency (they need the
+    // NEXT frame before they can fully deinterlace the current one), so the
+    // first call after construction (or after a seek resets the graph)
+    // typically returns false -- "nothing to present yet for this input",
+    // not an error. Returns true and fills `outFrame`/`outStartTime`/
+    // `outDuration` once a deinterlaced frame is actually ready; `outFrame`
+    // is always a plain system-memory (non-hardware) frame, since yadif/
