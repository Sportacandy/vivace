new file mode 100644
index 0000000..9869393
--- /dev/null
+++ b/src/plugins/multimedia/ffmpeg/playbackengine/qffmpegdeinterlacer.cpp
@@ -0,0 +1,179 @@
+/*  Vivace — a fast, pure-Qt media player.
+    Copyright (C) 2026 Hironori Komaba
+    SPDX-License-Identifier: GPL-3.0-or-later
+*/
+
+#include "playbackengine/qffmpegdeinterlacer_p.h"
+
+#include <QtCore/qstring.h>
+
+extern "C" {
+#include <libavfilter/buffersink.h>
+#include <libavfilter/buffersrc.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/opt.h>
+}
+
+QT_BEGIN_NAMESPACE
+
+namespace QFFmpeg {
+
+Deinterlacer::~Deinterlacer()
+{
+    freeGraph();
+}
+
+void Deinterlacer::freeGraph()
+{
+    if (m_graph)
+        avfilter_graph_free(&m_graph);
+    m_srcCtx = nullptr;
+    m_sinkCtx = nullptr;
+}
+
+bool Deinterlacer::ensureGraph(const AVFrame *swFrame)
+{
+    if (m_graph && m_width == swFrame->width && m_height == swFrame->height
+        && m_pixFmt == swFrame->format)
+        return true;
+
+    freeGraph();
+    m_pending.clear();
+    m_width = swFrame->width;
+    m_height = swFrame->height;
+    m_pixFmt = swFrame->format;
+
+    m_graph = avfilter_graph_alloc();
+    if (!m_graph)
+        return false;
+
+    AVRational sar = swFrame->sample_aspect_ratio;
+    if (sar.num <= 0 || sar.den <= 0)
+        sar = AVRational{ 1, 1 };
+
+    // The declared time_base here is arbitrary and never round-tripped back
+    // out: this class tracks each frame's real Vivace/Qt timing itself (see
+    // m_pending) rather than relying on the filter graph's own pts math, so
+    // any consistent, valid time_base is fine -- yadif/bwdif's temporal
+    // deinterlacing logic operates on the RELATIVE ORDER frames are pushed
+    // in, not on real elapsed time.
+    const QByteArray srcArgs = QStringLiteral("video_size=%1x%2:pix_fmt=%3:time_base=1/1000000:"
+                                               "pixel_aspect=%4/%5")
+                                        .arg(m_width)
+                                        .arg(m_height)
+                                        .arg(m_pixFmt)
+                                        .arg(sar.num)
+                                        .arg(sar.den)
+                                        .toLatin1();
+
+    const AVFilter *bufferFilter = avfilter_get_by_name("buffer");
+    const AVFilter *sinkFilter = avfilter_get_by_name("buffersink");
+    const AVFilter *deintFilter = avfilter_get_by_name(m_mode == Yadif ? "yadif" : "bwdif");
+    if (!bufferFilter || !sinkFilter || !deintFilter) {
+        freeGraph();
+        return false;
+    }
+
+    if (avfilter_graph_create_filter(&m_srcCtx, bufferFilter, "vivace_deint_in",
+                                      srcArgs.constData(), nullptr, m_graph) < 0) {
+        freeGraph();
+        return false;
+    }
+
+    // mode=0 (send_frame, one output per input) explicitly, since bwdif's
+    // own default is mode=1 (send_field/"double framerate") -- this patch
+    // only supports the single-rate case (see qffmpegdeinterlacer_p.h).
+    // parity=-1 (auto) already matches yadif/bwdif's own default, kept
+    // explicit for clarity/future-proofing.
+    //
+    // deint: explicit Yadif/Bwdif (deint=0/"all") deinterlace unconditionally
+    // -- Vivace has no interlace auto-detection of its own there (matching
+    // SMPlayer's own always-manual Deinterlace menu), so deint=0 is what
+    // makes "the user turned this mode on" apply to every frame. Auto
+    // (deint=1/"interlaced") instead only deinterlaces frames the decoder
+    // itself flagged AV_FRAME_FLAG_INTERLACED, passing everything else
+    // through untouched -- see qffmpegdeinterlacer_p.h's own file comment.
+    const char *deintArgs = m_mode == Auto ? "mode=0:parity=-1:deint=1" : "mode=0:parity=-1:deint=0";
+    AVFilterContext *deintCtx = nullptr;
+    if (avfilter_graph_create_filter(&deintCtx, deintFilter, "vivace_deint", deintArgs, nullptr,
+                                      m_graph) < 0) {
+        freeGraph();
+        return false;
+    }
+
+    if (avfilter_graph_create_filter(&m_sinkCtx, sinkFilter, "vivace_deint_out", nullptr, nullptr,
+                                      m_graph) < 0) {
+        freeGraph();
+        return false;
+    }
+
+    // Constrain the sink to the same pixel format fed in, so yadif/bwdif's
+    // pass-through output can't trigger an implicit, unwanted conversion
+    // node downstream of QFFmpegVideoBuffer's expectations.
+    const enum AVPixelFormat pixFmts[] = { AVPixelFormat(m_pixFmt), AV_PIX_FMT_NONE };
+    av_opt_set_int_list(m_sinkCtx, "pix_fmts", pixFmts, AV_PIX_FMT_NONE, AV_OPT_SEARCH_CHILDREN);
+
+    if (avfilter_link(m_srcCtx, 0, deintCtx, 0) < 0 || avfilter_link(deintCtx, 0, m_sinkCtx, 0) < 0
+        || avfilter_graph_config(m_graph, nullptr) < 0) {
+        freeGraph();
+        return false;
+    }
+
+    return true;
+}
+
+bool Deinterlacer::process(AVFrame *inputFrame, TrackPosition startTime, TrackDuration duration,
+                            AVFrameUPtr &outFrame, TrackPosition &outStartTime,
+                            TrackDuration &outDuration)
+{
+    AVFrameUPtr downloaded;
+    const AVFrame *swFrame = inputFrame;
+    if (inputFrame->hw_frames_ctx) {
+        // yadif/bwdif are software-only filters; a hardware-decoded frame
+        // (VAAPI/D3D11VA/NVDEC/...) must be downloaded to system memory
+        // first -- and hwaccel decode is the DEFAULT path for exactly the
+        // codecs (H.264/MPEG-2) interlaced content is most likely to use,
+        // so skipping this would make deinterlacing silently do nothing (or
+        // fail) on the common case.
+        downloaded = makeAVFrame();
+        if (!downloaded || av_hwframe_transfer_data(downloaded.get(), inputFrame, 0) < 0)
+            return false;
+        av_frame_copy_props(downloaded.get(), inputFrame);
+        swFrame = downloaded.get();
+    }
+
+    if (!ensureGraph(swFrame))
+        return false;
+
+    m_pending.enqueue({ startTime, duration });
+    // av_buffersrc_add_frame_flags with KEEP_REF does not take ownership of
+    // swFrame -- it adds its own reference (or copies), leaving the caller's
+    // frame (inputFrame, or our own locally-owned `downloaded`) untouched.
+    if (av_buffersrc_add_frame_flags(m_srcCtx, const_cast<AVFrame *>(swFrame),
+                                      AV_BUFFERSRC_FLAG_KEEP_REF)
+        < 0) {
+        m_pending.removeLast();
+        return false;
+    }
+
+    AVFrameUPtr filtered = makeAVFrame();
+    if (!filtered || av_buffersink_get_frame(m_sinkCtx, filtered.get()) < 0) {
+        // Most commonly AVERROR(EAGAIN): the filter needs more input before
+        // it can produce output (yadif/bwdif look one frame ahead) -- not an
+        // error, just "nothing to present for this input frame yet".
+        return false;
+    }
+
+    if (m_pending.isEmpty())
+        return false; // defensive; should not happen given the 1:1 push/pop below
+
+    const auto timing = m_pending.dequeue();
+    outStartTime = timing.first;
+    outDuration = timing.second;
+    outFrame = std::move(filtered);
+    return true;
+}
+
+} // namespace QFFmpeg
+
+QT_END_NAMESPACE
diff --git a/src/plugins/multimedia/ffmpeg/playbackengine/qffmpegdeinterlacer_p.h b/src/plugins/multimedia/ffmpeg/playbackengine/qffmpegdeinterlacer_p.h
new file mode 100644
index 0000000..fa6b5fa
--- /dev/null
+++ b/src/plugins/multimedia/ffmpeg/playbackengine/qffmpegdeinterlacer_p.h
@@ -0,0 +1,147 @@
+/*  Vivace — a fast, pure-Qt media player.
+    Copyright (C) 2026 Hironori Komaba
+    SPDX-License-Identifier: GPL-3.0-or-later
+*/
+
+#ifndef QFFMPEGDEINTERLACER_P_H
+#define QFFMPEGDEINTERLACER_P_H
+
+//
+//  W A R N I N G
+//  -------------
+//
+// This file is not part of the Qt API. It exists purely as an
+// implementation detail. This header file may change from version to
+// version without notice, or even be removed.
+//
+// We mean it.
+//
+
+// Vivace: optional software deinterlacing for the FFmpeg playback path.
+// Qt Multimedia's own decode pipeline has no filter-graph stage at all and
+// no interlace awareness whatsoever (StreamDecoder::receiveAVFrames() hands
+// avcodec_receive_frame()'s raw AVFrame straight to a Frame/QVideoFrame),
+// so this is implemented as a small FFmpeg avfilter graph (yadif or bwdif)
+// spliced into VideoRenderer::renderInternal(), the sole AVFrame -> QVideoFrame
+// conversion point. Gated by the VIVACE_DEINTERLACE_MODE environment
+// variable (0 = auto/bwdif, 1 = yadif, 2 = bwdif, 3 = off/None), read fresh
+// by the renderer on every frame and set by Vivace's own C++
+// (PlayerController) whenever the user changes the Video > Deinterlace menu
+// selection or the Preferences > General > Video "Deinterlace by default"
+// setting -- the same env-var-relay pattern already used for
+// VIVACE_SUBTITLE_BITMAP_SMOOTHING.
+//
+// Auto is mode 0 -- Vivace's DEFAULT -- swapped in-place with what used to
+// be mode 0 (None/off, now mode 3) on 2026-08-22 at the user's explicit
+// request ("make 'Auto' default... by swapping 'None' and 'Auto'... this is
+// a compatibility break but acceptable"): a value a user previously
+// persisted for one of these two modes is now interpreted as the OTHER one.
+// Since 0 is also what qEnvironmentVariableIntValue() returns for an unset
+// variable, this swap has a convenient side effect: even before Vivace's
+// own PlayerController ever calls qputenv() for the first time (e.g. any
+// hypothetical future caller that forgets to), an unset env var now safely
+// resolves to Auto rather than fully off, matching the new intended
+// default. `None` is only ever compared against by VideoRenderer's own
+// gate below (see qffmpegvideorenderer.cpp) to decide whether to construct
+// a Deinterlacer at all -- it is never itself passed to this class's own
+// constructor.
+//
+// Auto (mode 0) always uses bwdif (the higher-quality of the two supported
+// filters -- see the user-facing help text) with yadif/bwdif's own built-in
+// "deint" AVOption set to "interlaced" instead of "all": the filter then
+// deinterlaces only frames the DECODER ITSELF marked with
+// AV_FRAME_FLAG_INTERLACED (a real, per-frame flag FFmpeg derives directly
+// from the bitstream's own coding structure -- e.g. MPEG-2's
+// picture_structure or H.264's field_pic_flag/SEI), passing every other
+// frame through unmodified. This needed NO media-info-scanning of Vivace's
+// own -- FFmpeg's decoders already do the real detection work per frame,
+// and yadif/bwdif already exposed a way to act on it; Vivace only had to
+// select "interlaced" over "all" for this one mode. Explicit Yadif/Bwdif
+// (modes 1/2) keep "all" (deinterlace unconditionally), matching SMPlayer's
+// own always-manual Deinterlace menu (see mediasettings.h) -- Auto is a
+// genuinely new capability beyond what SMPlayer/mplayer/mpv offer.
+//
+// SCOPE: single-rate only (one output frame per input frame -- yadif/bwdif
+// "mode=send_frame"), NOT the "double framerate"/bob variants. Those need
+// the ability to inject a second, synthesized frame with its own timestamp
+// per input frame, which Renderer's frame-queueing (a private, one-Frame-
+// per-renderInternal()-call contract) does not support without much deeper
+// surgery -- out of scope for this patch.
+
+#include <QtFFmpegMediaPluginImpl/private/qffmpegplaybackutils_p.h>
+#include <QtFFmpegMediaPluginImpl/private/qffmpegtime_p.h>
+#include <QtFFmpegMediaPluginImpl/private/qffmpeg_p.h>
+
+#include <QtCore/qqueue.h>
+
+#include <utility>
+
+extern "C" {
+#include <libavfilter/avfilter.h>
+}
+
+QT_BEGIN_NAMESPACE
+
+namespace QFFmpeg {
+
+class Deinterlacer
+{
+public:
+    enum Mode {
+        Auto = 0,
+        Yadif = 1,
+        Bwdif = 2,
+        // Never passed to this class's own constructor -- a Deinterlacer
+        // is never constructed at all for this mode (see the gate in
+        // VideoRenderer::renderInternal(), qffmpegvideorenderer.cpp).
+        // Named here purely so callers have a symbolic constant to compare
+        // against instead of a bare "3".
+        None = 3,
+    };
+
+    explicit Deinterlacer(int mode) : m_mode(mode) { }
+    ~Deinterlacer();
+
+    Q_DISABLE_COPY_MOVE(Deinterlacer)
+
+    int mode() const { return m_mode; }
+
+    // Pushes a reference to `inputFrame` (NOT consumed -- the caller keeps
+    // ownership) into the filter graph, tagged with `startTime`/`duration`.
+    // yadif/bwdif have a fixed one-frame lookahead latency (they need the
+    // NEXT frame before they can fully deinterlace the current one), so the
+    // first call after construction (or after a seek resets the graph)
+    // typically returns false -- "nothing to present yet for this input",
+    // not an error. Returns true and fills `outFrame`/`outStartTime`/
+    // `outDuration` once a deinterlaced frame is actually ready; `outFrame`
+    // is always a plain system-memory (non-hardware) frame, since yadif/
+    // bwdif are software-only filters (a hardware-decoded input is
+    // downloaded via av_hwframe_transfer_data() first).
+    //
+    // KNOWN LIMITATION: because of this one-frame latency, the very last
+    // frame pushed before end-of-stream is never retrieved (nothing pushes
+    // a following frame to trigger it, and this class does not flush the
+    // graph at EOF) -- a single dropped frame at the end of deinterlaced
+    // playback, matching the accepted scope of this patch.
+    bool process(AVFrame *inputFrame, TrackPosition startTime, TrackDuration duration,
+                 AVFrameUPtr &outFrame, TrackPosition &outStartTime, TrackDuration &outDuration);
+
+private:
+    bool ensureGraph(const AVFrame *swFrame);
+    void freeGraph();
+
+    int m_mode = Yadif;
+    AVFilterGraph *m_graph = nullptr;
+    AVFilterContext *m_srcCtx = nullptr;
+    AVFilterContext *m_sinkCtx = nullptr;
+    int m_width = 0;
+    int m_height = 0;
+    int m_pixFmt = -1;
+    QQueue<std::pair<TrackPosition, TrackDuration>> m_pending;
+};
+
+} // namespace QFFmpeg
+
+QT_END_NAMESPACE
+
+#endif // QFFMPEGDEINTERLACER_P_H
diff --git a/src/plugins/multimedia/ffmpeg/playbackengine/qffmpegvideorenderer.cpp b/src/plugins/multimedia/ffmpeg/playbackengine/qffmpegvideorenderer.cpp
index 83792ce..7cac84e 100644
--- a/src/plugins/multimedia/ffmpeg/playbackengine/qffmpegvideorenderer.cpp
+++ b/src/plugins/multimedia/ffmpeg/playbackengine/qffmpegvideorenderer.cpp
@@ -6,6 +6,8 @@
 #include "qvideosink.h"
 #include "private/qvideoframe_p.h"
 
+#include <QtCore/qglobal.h>
+
 QT_BEGIN_NAMESPACE
 
 namespace QFFmpeg {
@@ -36,6 +38,8 @@ VideoRenderer::RenderingResult VideoRenderer::renderInternal(Frame frame)
         return {};
 
     if (!frame.isValid()) {
+        m_deinterlacer.reset(); // vivace: drop any pending filter state at end of stream
+        m_deinterlaceLoggedFirstFrame = false;
         m_sink->setVideoFrame({});
         return {};
     }
@@ -45,6 +49,100 @@ VideoRenderer::RenderingResult VideoRenderer::renderInternal(Frame frame)
     const auto codecContext = frame.codecContext();
     Q_ASSERT(codecContext);
 
+    // Vivace: optional software deinterlacing (yadif/bwdif) via an FFmpeg
+    // avfilter graph -- see qffmpegdeinterlacer_p.h. Gated by an env var
+    // rather than a proper Qt property since this plugin has no reach into
+    // the app's own Settings; PlayerController relays the user's Video >
+    // Deinterlace choice into it with qputenv() on every change.
+    //
+    // Deinterlacer::None (3) is the only mode that bypasses this path
+    // entirely -- Auto/Yadif/Bwdif (0/1/2) all construct/use a Deinterlacer.
+    // Checking "!= None" rather than "> 0" is deliberate: Auto is mode 0
+    // (see qffmpegdeinterlacer_p.h's own file comment for why), so a plain
+    // "> 0" gate would have wrongly excluded it.
+    //
+    // Per-sink opt-out (2026-08-27, real regression fix): yadif/bwdif have
+    // a genuine one-frame lookahead -- they only emit output for frame N
+    // once frame N+1 has also been pushed. That's invisible during
+    // ordinary continuous playback (the next frame arrives moments later),
+    // but Vivace also has a SEPARATE, paused QMediaPlayer for its seek-bar
+    // hover-preview thumbnail: it does a single setPosition() and expects
+    // exactly one resulting frame, with nothing further arriving after it.
+    // Once Auto became the default deinterlace mode, that preview's own
+    // VideoRenderer (a distinct instance, but reading the SAME process-wide
+    // env var) started hitting this exact case on every hover -- the first
+    // (only) frame it ever receives is permanently stuck "still buffering",
+    // so QVideoSink::setVideoFrame() is never called and the preview shows
+    // solid black. Fixing the Deinterlacer's own buffering to tolerate a
+    // one-shot caller would need real filter-graph-state surgery (a stray
+    // duplicate-pushed frame's own output would otherwise resurface out of
+    // order against a LATER genuine frame, corrupting timing for actual
+    // continuous playback -- not attempted). Instead, since Vivace's
+    // PlayerController owns and constructs BOTH QVideoSink instances
+    // itself, it tags the preview-only one with a plain dynamic property
+    // (no new Q_PROPERTY/API surface needed) that this renderer checks
+    // here -- deinterlacing a tiny, briefly-shown hover thumbnail was never
+    // going to be visually meaningful anyway, so skipping it entirely for
+    // that ONE sink (leaving the main player's own sink, and therefore
+    // ordinary playback, completely unaffected) is a correct trade, not
+    // just an easy one.
+    const int deinterlaceMode = qEnvironmentVariableIntValue("VIVACE_DEINTERLACE_MODE");
+    const bool deinterlaceDisabledForThisSink =
+            m_sink && m_sink->property("vivace_no_deinterlace").toBool();
+    if (deinterlaceMode != Deinterlacer::None && !deinterlaceDisabledForThisSink) {
+        if (!m_deinterlacer || m_deinterlacer->mode() != deinterlaceMode) {
+            m_deinterlacer = std::make_unique<Deinterlacer>(deinterlaceMode);
+            // vivace: one-time-per-(re)construction diagnostic, kept
+            // permanently (matches this project's other qtmultimedia-patch
+            // diagnostics) so a user can confirm via vivace.log that this
+            // path is genuinely active, distinct from "the effect is just
+            // imperceptible on this particular (progressive) source".
+            const char *modeName = deinterlaceMode == Deinterlacer::Yadif
+                    ? "yadif"
+                    : deinterlaceMode == Deinterlacer::Bwdif ? "bwdif" : "bwdif, auto/interlaced-only";
+            qWarning("vivace: deinterlace enabled, mode=%d (%s)", deinterlaceMode, modeName);
+            m_deinterlaceLoggedFirstFrame = false;
+        }
+
+        AVFrameUPtr filtered;
+        // TrackPosition/TrackDuration (QTaggedTimePoint/QTaggedDuration,
+        // qtaggedtime_p.h) have no default constructor -- only one taking an
+        // explicit qint64 -- so these must be seeded with a value, not
+        // left bare; process() overwrites both before they're used whenever
+        // it returns true.
+        TrackPosition outStartTime(0);
+        TrackDuration outDuration(0);
+        const bool haveOutput = m_deinterlacer->process(frame.avFrame(), frame.startTime(),
+                                                          frame.duration(), filtered, outStartTime,
+                                                          outDuration);
+        if (!haveOutput)
+            return {}; // filter is still buffering; nothing to present for this input frame yet
+
+        if (!m_deinterlaceLoggedFirstFrame) {
+            m_deinterlaceLoggedFirstFrame = true;
+            qWarning("vivace: deinterlace producing filtered output frames");
+        }
+
+        const auto pixelAspectRatio = codecContext->pixelAspectRatio(filtered.get());
+        auto buffer = std::make_unique<QFFmpegVideoBuffer>(std::move(filtered), pixelAspectRatio);
+        QVideoFrameFormat format(buffer->size(), buffer->pixelFormat());
+        format.setColorSpace(buffer->colorSpace());
+        format.setColorTransfer(buffer->colorTransfer());
+        format.setColorRange(buffer->colorRange());
+        format.setMaxLuminance(buffer->maxNits());
+        format.setRotation(m_transform.rotation);
+        format.setMirrored(m_transform.mirroredHorizontallyAfterRotation);
+        QVideoFrame videoFrame = QVideoFramePrivate::createFrame(std::move(buffer), format);
+        videoFrame.setStartTime(outStartTime.get());
+        videoFrame.setEndTime((outStartTime + outDuration).get());
+        m_sink->setVideoFrame(videoFrame);
+        return {};
+    }
+    if (m_deinterlacer) {
+        m_deinterlacer.reset(); // vivace: mode turned off; drop filter state
+        m_deinterlaceLoggedFirstFrame = false;
+    }
+
 #ifdef Q_OS_ANDROID
     // QTBUG-108446
     // In general case, just creation of frames context is not correct since
@@ -80,6 +178,16 @@ VideoRenderer::RenderingResult VideoRenderer::renderInternal(Frame frame)
     return {};
 }
 
+void VideoRenderer::seekInternal()
+{
+    // vivace: a seek jumps to frames the deinterlace filter's buffered
+    // state (and pending-timing FIFO) knows nothing about -- drop it so the
+    // next renderInternal() call rebuilds a fresh graph instead of pairing
+    // stale timing with a post-seek frame.
+    m_deinterlacer.reset();
+    m_deinterlaceLoggedFirstFrame = false;
+}
+
 } // namespace QFFmpeg
 
 QT_END_NAMESPACE
