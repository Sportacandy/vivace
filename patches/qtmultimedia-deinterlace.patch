--- /dev/null
+++ b/src/plugins/multimedia/ffmpeg/playbackengine/qffmpegdeinterlacer.cpp
@@ -0,0 +1,174 @@
+/*  Vivace — a fast, pure-Qt media player.
+    Copyright (C) 2026 Hironori Komaba
+    SPDX-License-Identifier: GPL-3.0-or-later
+*/
+
+#include "playbackengine/qffmpegdeinterlacer_p.h"
+
+#include <QtCore/qstring.h>
+
+extern "C" {
+#include <libavfilter/buffersink.h>
+#include <libavfilter/buffersrc.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/opt.h>
+}
+
+QT_BEGIN_NAMESPACE
+
+namespace QFFmpeg {
+
+Deinterlacer::~Deinterlacer()
+{
+    freeGraph();
+}
+
+void Deinterlacer::freeGraph()
+{
+    if (m_graph)
+        avfilter_graph_free(&m_graph);
+    m_srcCtx = nullptr;
+    m_sinkCtx = nullptr;
+}
+
+bool Deinterlacer::ensureGraph(const AVFrame *swFrame)
+{
+    if (m_graph && m_width == swFrame->width && m_height == swFrame->height
+        && m_pixFmt == swFrame->format)
+        return true;
+
+    freeGraph();
+    m_pending.clear();
+    m_width = swFrame->width;
+    m_height = swFrame->height;
+    m_pixFmt = swFrame->format;
+
+    m_graph = avfilter_graph_alloc();
+    if (!m_graph)
+        return false;
+
+    AVRational sar = swFrame->sample_aspect_ratio;
+    if (sar.num <= 0 || sar.den <= 0)
+        sar = AVRational{ 1, 1 };
+
+    // The declared time_base here is arbitrary and never round-tripped back
+    // out: this class tracks each frame's real Vivace/Qt timing itself (see
+    // m_pending) rather than relying on the filter graph's own pts math, so
+    // any consistent, valid time_base is fine -- yadif/bwdif's temporal
+    // deinterlacing logic operates on the RELATIVE ORDER frames are pushed
+    // in, not on real elapsed time.
+    const QByteArray srcArgs = QStringLiteral("video_size=%1x%2:pix_fmt=%3:time_base=1/1000000:"
+                                               "pixel_aspect=%4/%5")
+                                        .arg(m_width)
+                                        .arg(m_height)
+                                        .arg(m_pixFmt)
+                                        .arg(sar.num)
+                                        .arg(sar.den)
+                                        .toLatin1();
+
+    const AVFilter *bufferFilter = avfilter_get_by_name("buffer");
+    const AVFilter *sinkFilter = avfilter_get_by_name("buffersink");
+    const AVFilter *deintFilter = avfilter_get_by_name(m_mode == Bwdif ? "bwdif" : "yadif");
+    if (!bufferFilter || !sinkFilter || !deintFilter) {
+        freeGraph();
+        return false;
+    }
+
+    if (avfilter_graph_create_filter(&m_srcCtx, bufferFilter, "vivace_deint_in",
+                                      srcArgs.constData(), nullptr, m_graph) < 0) {
+        freeGraph();
+        return false;
+    }
+
+    // mode=0 (send_frame, one output per input) explicitly, since bwdif's
+    // own default is mode=1 (send_field/"double framerate") -- this patch
+    // only supports the single-rate case (see qffmpegdeinterlacer_p.h).
+    // parity=-1 (auto) and deint=0 (deinterlace every frame, not only ones
+    // FFmpeg itself marked interlaced) both already match yadif/bwdif's own
+    // defaults, kept explicit for clarity/future-proofing. Vivace has no
+    // interlace auto-detection of its own (matching SMPlayer's own
+    // always-manual Deinterlace menu) -- deint=0 is what makes "the user
+    // turned this mode on" apply unconditionally.
+    AVFilterContext *deintCtx = nullptr;
+    if (avfilter_graph_create_filter(&deintCtx, deintFilter, "vivace_deint",
+                                      "mode=0:parity=-1:deint=0", nullptr, m_graph) < 0) {
+        freeGraph();
+        return false;
+    }
+
+    if (avfilter_graph_create_filter(&m_sinkCtx, sinkFilter, "vivace_deint_out", nullptr, nullptr,
+                                      m_graph) < 0) {
+        freeGraph();
+        return false;
+    }
+
+    // Constrain the sink to the same pixel format fed in, so yadif/bwdif's
+    // pass-through output can't trigger an implicit, unwanted conversion
+    // node downstream of QFFmpegVideoBuffer's expectations.
+    const enum AVPixelFormat pixFmts[] = { AVPixelFormat(m_pixFmt), AV_PIX_FMT_NONE };
+    av_opt_set_int_list(m_sinkCtx, "pix_fmts", pixFmts, AV_PIX_FMT_NONE, AV_OPT_SEARCH_CHILDREN);
+
+    if (avfilter_link(m_srcCtx, 0, deintCtx, 0) < 0 || avfilter_link(deintCtx, 0, m_sinkCtx, 0) < 0
+        || avfilter_graph_config(m_graph, nullptr) < 0) {
+        freeGraph();
+        return false;
+    }
+
+    return true;
+}
+
+bool Deinterlacer::process(AVFrame *inputFrame, TrackPosition startTime, TrackDuration duration,
+                            AVFrameUPtr &outFrame, TrackPosition &outStartTime,
+                            TrackDuration &outDuration)
+{
+    AVFrameUPtr downloaded;
+    const AVFrame *swFrame = inputFrame;
+    if (inputFrame->hw_frames_ctx) {
+        // yadif/bwdif are software-only filters; a hardware-decoded frame
+        // (VAAPI/D3D11VA/NVDEC/...) must be downloaded to system memory
+        // first -- and hwaccel decode is the DEFAULT path for exactly the
+        // codecs (H.264/MPEG-2) interlaced content is most likely to use,
+        // so skipping this would make deinterlacing silently do nothing (or
+        // fail) on the common case.
+        downloaded = makeAVFrame();
+        if (!downloaded || av_hwframe_transfer_data(downloaded.get(), inputFrame, 0) < 0)
+            return false;
+        av_frame_copy_props(downloaded.get(), inputFrame);
+        swFrame = downloaded.get();
+    }
+
+    if (!ensureGraph(swFrame))
+        return false;
+
+    m_pending.enqueue({ startTime, duration });
+    // av_buffersrc_add_frame_flags with KEEP_REF does not take ownership of
+    // swFrame -- it adds its own reference (or copies), leaving the caller's
+    // frame (inputFrame, or our own locally-owned `downloaded`) untouched.
+    if (av_buffersrc_add_frame_flags(m_srcCtx, const_cast<AVFrame *>(swFrame),
+                                      AV_BUFFERSRC_FLAG_KEEP_REF)
+        < 0) {
+        m_pending.removeLast();
+        return false;
+    }
+
+    AVFrameUPtr filtered = makeAVFrame();
+    if (!filtered || av_buffersink_get_frame(m_sinkCtx, filtered.get()) < 0) {
+        // Most commonly AVERROR(EAGAIN): the filter needs more input before
+        // it can produce output (yadif/bwdif look one frame ahead) -- not an
+        // error, just "nothing to present for this input frame yet".
+        return false;
+    }
+
+    if (m_pending.isEmpty())
+        return false; // defensive; should not happen given the 1:1 push/pop below
+
+    const auto timing = m_pending.dequeue();
+    outStartTime = timing.first;
+    outDuration = timing.second;
+    outFrame = std::move(filtered);
+    return true;
+}
+
+} // namespace QFFmpeg
+
+QT_END_NAMESPACE
