+void SubtitleRenderer::seekInternal()
+{
+    // VIVACE FIX 2026-08-17 (real Blu-ray disc testing, found via the
+    // user's own interactive seeking): a subtitle shown right before a
+    // seek stayed on screen -- possibly forever -- after seeking to a
+    // point with no subtitle activity nearby. Root cause: QVideoSink's
+    // subtitle state (m_subtitleText/m_subtitleImage) is STICKY -- it
+    // only changes when a subtitle Frame actually renders and calls
+    // setSubtitleText()/setSubtitleImage() again. Renderer::seek()
+    // replaces m_sessionCtx wholesale (discarding any frames still
+    // queued from before the seek), but nothing told the SINK itself
+    // that whatever it was last displaying is now stale -- so the old
+    // text/image just sits there until some LATER real subtitle event
+    // happens to arrive and overwrite it, which may not happen for a
+    // long time (or ever, e.g. a seek into the final subtitle-free
+    // stretch of a file). Fixed by clearing the sink here, in
+    // seekInternal() (Renderer's own seek() hook, called right after the
+    // frame queue is reset) -- mirrors the exact same clear this class's
+    // own destructor already does when tearing down entirely. If a real
+    // subtitle event covers the new seek position, decodeSubtitle()'s
+    // normal flow re-populates the sink correctly once that frame is
+    // decoded and rendered, same as it would for any ordinary seek.
+    if (m_sink) {
+        m_sink->setSubtitleText({});
+        m_sink->setSubtitleImage({}, {}, {});
+    }
 }
 
