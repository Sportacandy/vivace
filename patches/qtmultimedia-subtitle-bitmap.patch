 }
 
+void QPlatformVideoSink::setSubtitleImage(const QImage &image, const QRect &rect,
+                                           const QSize &codedSize)
+{
+    {
+        QMutexLocker locker(&m_mutex);
+        if (m_subtitleImage.cacheKey() == image.cacheKey() && m_subtitleImageRect == rect
+            && m_subtitleImageCodedSize == codedSize)
+            return;
+        m_subtitleImage = image;
+        m_subtitleImageRect = rect;
+        m_subtitleImageCodedSize = codedSize;
+    }
+    emit m_sink->subtitleImageChanged(image, rect, codedSize);
+}
+
+QImage QPlatformVideoSink::subtitleImage() const
+{
+    QMutexLocker locker(&m_mutex);
+    return m_subtitleImage;
+}
+
+QRect QPlatformVideoSink::subtitleImageRect() const
+{
+    QMutexLocker locker(&m_mutex);
+    return m_subtitleImageRect;
+}
+
+QSize QPlatformVideoSink::subtitleImageCodedSize() const
+{
+    QMutexLocker locker(&m_mutex);
+    return m_subtitleImageCodedSize;
+}
