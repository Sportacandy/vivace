+        m_sink->setSubtitleImage(frame.isValid() ? frame.image() : QImage(),
+                                  frame.isValid() ? frame.imageRect() : QRect(),
+                                  frame.isValid() ? frame.imageCodedSize() : QSize());
+    }
 
     return {};
 }
