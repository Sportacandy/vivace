+// Soften a decoded bitmap subtitle's coarse antialiasing steps -- the same
+// visible "jaggy" issue, and the same triangular-kernel blur fix, as
+// Vivace's own PlayerController::softenSubtitleEdges() applies to DVD-disc
+// subtitles. Duplicated here (not shared code) because THIS pipeline -- an
+// embedded dvd_subtitle-codec track in an ordinary media file, decoded by
+// FFmpeg directly rather than through Vivace's own DVD IFO/VOB parsing --
+// lives entirely inside qtmultimedia and has no way to call back into the
+// application. Controlled by VIVACE_SUBTITLE_BITMAP_SMOOTHING (0 = off,
+// 1-3 = increasing blur radius, read fresh on every call rather than
+// cached, so it can change live), which Vivace keeps in sync with its
+// Settings.dvdSubtitleSmoothing preference (see
+// PlayerController::setDvdSubtitleSmoothing()) so one Preferences control
+// governs both bitmap-subtitle pipelines. Not a uniform box blur (see the
+// Vivace-side function's own comment for why): the triangular (tent)
+// kernel weights the center tap much more heavily, so a fully-opaque
+// interior pixel stays close to fully opaque while actual edge pixels are
+// still meaningfully softened.
+static QImage vivaceSoftenBitmapSubtitle(const QImage &src)
+{
+    const int radius = qBound(0,
+            qEnvironmentVariableIntValue("VIVACE_SUBTITLE_BITMAP_SMOOTHING"), 3);
+    if (radius <= 0 || src.isNull())
+        return src;
+    const QImage premult = src.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    const int w = premult.width();
+    const int h = premult.height();
+    QImage pass1(w, h, QImage::Format_ARGB32_Premultiplied);
+    for (int y = 0; y < h; ++y) {
+        const QRgb *srcLine = reinterpret_cast<const QRgb *>(premult.constScanLine(y));
+        QRgb *dstLine = reinterpret_cast<QRgb *>(pass1.scanLine(y));
+        for (int x = 0; x < w; ++x) {
+            int sa = 0, sr = 0, sg = 0, sb = 0, weightSum = 0;
+            for (int d = -radius; d <= radius; ++d) {
+                const int sx = x + d;
+                if (sx < 0 || sx >= w)
+                    continue;
+                const int weight = radius + 1 - qAbs(d);
+                const QRgb p = srcLine[sx];
+                sa += qAlpha(p) * weight; sr += qRed(p) * weight;
+                sg += qGreen(p) * weight; sb += qBlue(p) * weight;
+                weightSum += weight;
+            }
+            dstLine[x] = qRgba(sr / weightSum, sg / weightSum, sb / weightSum, sa / weightSum);
+        }
+    }
+    QImage pass2(w, h, QImage::Format_ARGB32_Premultiplied);
+    for (int y = 0; y < h; ++y) {
+        QRgb *dstLine = reinterpret_cast<QRgb *>(pass2.scanLine(y));
+        for (int x = 0; x < w; ++x) {
+            int sa = 0, sr = 0, sg = 0, sb = 0, weightSum = 0;
+            for (int d = -radius; d <= radius; ++d) {
+                const int sy = y + d;
+                if (sy < 0 || sy >= h)
+                    continue;
+                const int weight = radius + 1 - qAbs(d);
+                const QRgb p = reinterpret_cast<const QRgb *>(pass1.constScanLine(sy))[x];
+                sa += qAlpha(p) * weight; sr += qRed(p) * weight;
+                sg += qGreen(p) * weight; sb += qBlue(p) * weight;
+                weightSum += weight;
+            }
+            dstLine[x] = qRgba(sr / weightSum, sg / weightSum, sb / weightSum, sa / weightSum);
+        }
+    }
+    return pass2.convertToFormat(QImage::Format_ARGB32);
+}
