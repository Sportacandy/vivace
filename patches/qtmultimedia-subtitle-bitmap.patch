+/*!
+    Returns the bitmap-type embedded subtitle (DVD/PGS/DVB) that should be
+    rendered together with this video frame, or a null QImage if the
+    current subtitle is text-based or absent.
+*/
+QImage QVideoFrame::subtitleImage() const
+{
+    return d ? d->subtitleImage : QImage();
+}
+
+/*!
+    Returns the placement of subtitleImage(), in the subtitle codec's own
+    coded-frame coordinate space (not necessarily this video frame's own
+    display size -- callers must scale accordingly, using
+    subtitleImageCodedSize() as that coordinate space's extent).
+*/
+QRect QVideoFrame::subtitleImageRect() const
+{
+    return d ? d->subtitleImageRect : QRect();
+}
+
+/*!
+    Returns the extent of the coordinate space subtitleImageRect() is
+    expressed in (the subtitle decoder's own coded-frame size), or an
+    invalid QSize if there is no bitmap-type subtitle.
+*/
+QSize QVideoFrame::subtitleImageCodedSize() const
+{
+    return d ? d->subtitleImageCodedSize : QSize();
+}
+
+/*!
+    Sets the bitmap-type embedded subtitle that should be rendered together
+    with this video frame to \a image, placed at \a rect within a
+    coded-frame extent of \a codedSize.
+*/
+void QVideoFrame::setSubtitleImage(const QImage &image, const QRect &rect, const QSize &codedSize)
+{
+    if (!d)
+        return;
+    d->subtitleImage = image;
+    d->subtitleImageRect = rect;
+    d->subtitleImageCodedSize = codedSize;
+}
